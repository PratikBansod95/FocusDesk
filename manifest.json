{

  "manifest_version": 3,

  "name": "FocusDesk",

  "version": "2.1.0",

  "description": "A notepad-style task and project tracker for your New Tab.",

  "permissions": ["storage"],

  "chrome_url_overrides": {

    "newtab": "newtab.html"

  },

  "icons": {

    "16": "assets/icons/icon-16.png",

    "48": "assets/icons/icon-48.png",

    "128": "assets/icons/icon-128.png"

  }

}


